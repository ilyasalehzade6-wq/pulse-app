/* ============================================================
   🎨 Dashboard Styles
   ============================================================ */

body.dashboard-body {
    padding: 0;
    overflow-x: hidden;
}

/* ============================================================
   🔝 Topbar
   ============================================================ */
.topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border-2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 12px 20px;
}

.topbar-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.topbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.topbar-logo {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-2) 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    box-shadow: 0 4px 12px rgba(241, 196, 15, 0.3);
}

.topbar-name {
    font-size: 16px;
    font-weight: 800;
    color: var(--gold);
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.user-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: var(--card);
    border: 1px solid var(--border-2);
    border-radius: 100px;
}

.user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-2) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    color: #000;
    font-weight: 800;
}

.user-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
}

.icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--border-2);
    background: var(--card);
    color: var(--text);
    cursor: pointer;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s;
}

.icon-btn:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
}

/* ============================================================
   📦 Layout
   ============================================================ */
.app-layout {
    display: flex;
    max-width: 1400px;
    margin: 0 auto;
    min-height: calc(100vh - 64px);
}

/* ============================================================
   📋 Sidebar
   ============================================================ */
.sidebar {
    width: 240px;
    padding: 20px 12px;
    border-left: 1px solid var(--border-2);
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 10px;
    color: var(--text-2);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
    background: transparent;
    font-family: inherit;
    text-align: right;
    width: 100%;
}

.nav-item:hover {
    background: var(--card);
    color: var(--text);
}

.nav-item.active {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-2) 100%);
    color: #000;
}

.nav-icon {
    font-size: 18px;
}

/* ============================================================
   📄 Main Content
   ============================================================ */
.main-content {
    flex: 1;
    padding: 24px;
    min-width: 0;
}

/* ============================================================
   👋 Welcome
   ============================================================ */
.welcome-section {
    margin-bottom: 24px;
}

.welcome-greeting {
    font-size: 24px;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 4px;
}

.welcome-subtitle {
    font-size: 14px;
    color: var(--text-dim);
}

.subscription-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    margin-top: 8px;
}

.subscription-badge.trial {
    background: rgba(52, 152, 219, 0.15);
    color: var(--blue);
    border: 1px solid rgba(52, 152, 219, 0.3);
}

.subscription-badge.active {
    background: rgba(46, 204, 113, 0.15);
    color: var(--green);
    border: 1px solid rgba(46, 204, 113, 0.3);
}

.subscription-badge.expired {
    background: rgba(231, 76, 60, 0.15);
    color: var(--red);
    border: 1px solid rgba(231, 76, 60, 0.3);
}

/* ============================================================
   📊 Stat Cards
   ============================================================ */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
}

.stat-card {
    background: var(--card);
    border: 1px solid var(--border-2);
    border-radius: 16px;
    padding: 18px;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 14px;
}

.stat-card:hover {
    border-color: var(--border);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
}

.stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
    background: linear-gradient(135deg, rgba(241, 196, 15, 0.15) 0%, rgba(241, 196, 15, 0.05) 100%);
    border: 1px solid var(--border);
}

.stat-info {
    flex: 1;
    min-width: 0;
}

.stat-label {
    font-size: 12px;
    color: var(--text-dim);
    margin-bottom: 3px;
}

.stat-value {
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    font-family: 'Consolas', monospace;
    direction: ltr;
    text-align: right;
    line-height: 1.2;
}

/* ============================================================
   🎴 Action Cards
   ============================================================ */
.action-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
}

.action-card {
    background: var(--card);
    border: 1px solid var(--border-2);
    border-radius: 18px;
    padding: 24px 20px;
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
}

.action-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(241, 196, 15, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    transform: translate(40%, -40%);
}

.action-card:hover {
    border-color: var(--border);
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.action-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    position: relative;
}

.action-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-2) 100%);
    box-shadow: 0 8px 20px rgba(241, 196, 15, 0.25);
    flex-shrink: 0;
}

.action-card-title {
    font-size: 16px;
    font-weight: 800;
    color: var(--text);
}

.action-card-desc {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 16px;
    position: relative;
}

.action-buttons {
    display: flex;
    gap: 8px;
    position: relative;
    flex-wrap: wrap;
}

.btn-sm {
    padding: 10px 18px;
    font-size: 13px;
    height: auto;
    flex: 1;
    min-width: 100px;
}

.btn-gold {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-2) 100%);
    color: #000;
    box-shadow: 0 4px 12px rgba(241, 196, 15, 0.3);
}

.btn-gold:hover {
    box-shadow: 0 8px 20px rgba(241, 196, 15, 0.4);
    transform: translateY(-2px);
}

.btn-blue {
    background: linear-gradient(135deg, #0088CC 0%, #006699 100%);
    color: #fff;
    box-shadow: 0 4px 12px rgba(0, 136, 204, 0.3);
}

.btn-green {
    background: linear-gradient(135deg, var(--green) 0%, #27AE60 100%);
    color: #fff;
    box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
}

.btn-ghost {
    background: transparent;
    color: var(--text-2);
    border: 1.5px solid var(--border-2);
}

.btn-ghost:hover {
    border-color: var(--gold);
    color: var(--gold);
}

/* ============================================================
   📊 Progress Bar
   ============================================================ */
.progress-section {
    background: var(--card);
    border: 1px solid var(--border-2);
    border-radius: 18px;
    padding: 20px;
    margin-top: 24px;
}

.progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.progress-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
}

.progress-percent {
    font-size: 14px;
    font-weight: 800;
    color: var(--gold);
    font-family: 'Consolas', monospace;
}

.progress-bar {
    height: 10px;
    background: var(--input-bg);
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 8px;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold) 0%, var(--gold-2) 100%);
    border-radius: 5px;
    transition: width 0.8s ease;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-dim);
}

/* ============================================================
   🔔 Empty State
   ============================================================ */
.empty-state {
    text-align: center;
    padding: 40px 20px;
    background: var(--card);
    border: 1px dashed var(--border-2);
    border-radius: 16px;
    margin-top: 24px;
}

.empty-icon {
    font-size: 48px;
    margin-bottom: 12px;
    opacity: 0.7;
}

.empty-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
}

.empty-desc {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.8;
    max-width: 400px;
    margin: 0 auto 18px;
}

/* ============================================================
   🍔 Mobile Menu
   ============================================================ */
.menu-toggle {
    display: none;
}

@media (max-width: 900px) {
    .app-layout {
        flex-direction: column;
    }

    .sidebar {
        position: fixed;
        top: 64px;
        right: -100%;
        width: 260px;
        height: calc(100vh - 64px);
        background: var(--card);
        z-index: 99;
        border-left: 1px solid var(--border-2);
        transition: right 0.3s;
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.3);
    }

    .sidebar.open {
        right: 0;
    }

    .menu-toggle {
        display: flex;
    }

    .main-content {
        padding: 16px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .stat-card {
        padding: 14px;
        flex-direction: column;
        text-align: center;
        gap: 8px;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        font-size: 20px;
    }

    .stat-value {
        font-size: 18px;
    }

    .welcome-greeting {
        font-size: 20px;
    }

    .user-name {
        display: none;
    }
}

@media (max-width: 480px) {
    .topbar {
        padding: 10px 14px;
    }

    .topbar-name {
        font-size: 14px;
    }

    .action-grid {
        grid-template-columns: 1fr;
    }

    .btn-sm {
        min-width: 80px;
        padding: 8px 12px;
        font-size: 12px;
    }
}

/* ============================================================
   ⏳ Loading
   ============================================================ */
.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
}

.loading-spinner {
    width: 50px;
    height: 50px;
    border: 4px solid var(--border-2);
    border-top-color: var(--gold);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 16px;
}

.loading-text {
    font-size: 14px;
    color: var(--text-dim);
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ═══════════════════════════════════════════════════════
   👥 Members
   ═══════════════════════════════════════════════════════ */
.page-header {
    margin-bottom: 24px;
}

.page-title {
    font-size: 24px;
    font-weight: 700;
    color: #f1c40f;
    margin-bottom: 6px;
}

.page-subtitle {
    font-size: 13px;
    color: #95a5a6;
}

.toolbar {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.search-input {
    flex: 1;
    min-width: 200px;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid #2c3e50;
    background: #1a1a2e;
    color: white;
    font-family: inherit;
    font-size: 14px;
}

.search-input:focus {
    outline: none;
    border-color: #f1c40f;
}

.members-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.member-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: #1a1a2e;
    border: 1px solid #2c3e50;
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.2s;
}

.member-card:hover {
    border-color: #f1c40f;
    transform: translateX(-4px);
}

.member-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f1c40f, #d4ac0d);
    color: #0a0a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    flex-shrink: 0;
}

.member-info {
    flex: 1;
    min-width: 0;
}

.member-name {
    font-size: 15px;
    font-weight: 700;
    color: white;
    margin-bottom: 4px;
}

.member-meta {
    display: flex;
    gap: 12px;
    font-size: 12px;
    color: #95a5a6;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.member-class {
    font-size: 12px;
    color: #3498db;
}

.member-status {
    flex-shrink: 0;
}

.status-badge {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 14px;
}

.status-badge.active {
    background: rgba(46, 204, 113, 0.15);
}

.status-badge.inactive {
    background: rgba(149, 165, 166, 0.15);
}

/* ═══════════════════════════════════════════════════════
   🔒 Modal
   ═══════════════════════════════════════════════════════ */
.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
    animation: fadeIn 0.2s;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.modal-content {
    background: #1a1a2e;
    border: 1px solid #2c3e50;
    border-radius: 16px;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    direction: rtl;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid #2c3e50;
}

.modal-header h2 {
    font-size: 18px;
    color: #f1c40f;
}

.modal-close {
    background: transparent;
    border: none;
    color: #95a5a6;
    font-size: 20px;
    cursor: pointer;
}

.modal-body {
    padding: 24px;
}

.modal-footer {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    padding: 16px 24px;
    border-top: 1px solid #2c3e50;
}

.modal-body .form-group {
    margin-bottom: 16px;
}

.modal-body .form-label {
    display: block;
    font-size: 13px;
    color: #95a5a6;
    margin-bottom: 6px;
}

.modal-body .form-input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid #2c3e50;
    background: #0d0d1a;
    color: white;
    font-family: inherit;
    font-size: 14px;
}

.modal-body .form-input:focus {
    outline: none;
    border-color: #f1c40f;
}

.detail-row {
    padding: 12px 0;
    border-bottom: 1px solid #2c3e50;
    font-size: 14px;
    color: white;
    display: flex;
    justify-content: space-between;
}

.detail-row strong {
    color: #95a5a6;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
}

.btn {
    padding: 12px 20px;
    border-radius: 10px;
    border: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-sm {
    padding: 10px 16px;
    font-size: 13px;
}

.btn-gold {
    background: #f1c40f;
    color: #0a0a1a;
}

.btn-gold:hover {
    background: #d4ac0d;
}

.btn-ghost {
    background: transparent;
    color: #95a5a6;
    border: 1px solid #2c3e50;
}

.btn-ghost:hover {
    color: white;
    border-color: white;
}

/* ═══════════════════════════════════════════════════════
   ✅ Attendance
   ═══════════════════════════════════════════════════════ */
.date-section {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    background: #1a1a2e;
    border: 1px solid #2c3e50;
    border-radius: 14px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.date-label {
    font-size: 14px;
    color: #95a5a6;
    font-weight: 600;
}

.date-input {
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid #2c3e50;
    background: #0d0d1a;
    color: white;
    font-family: inherit;
    font-size: 14px;
}

.date-input:focus {
    outline: none;
    border-color: #f1c40f;
}

.quick-checkin-section {
    padding: 20px;
    background: linear-gradient(135deg, #1a1a2e 0%, #252540 100%);
    border: 1px solid #f1c40f;
    border-radius: 14px;
    margin-bottom: 24px;
}

.section-title {
    font-size: 16px;
    font-weight: 700;
    color: #f1c40f;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-hint {
    font-size: 12px;
    color: #95a5a6;
    margin-bottom: 15px;
}

.quick-search-wrapper {
    position: relative;
}

.quick-search-input {
    width: 100%;
    padding: 16px 20px;
    border-radius: 12px;
    border: 2px solid #2c3e50;
    background: #0d0d1a;
    color: white;
    font-family: inherit;
    font-size: 16px;
    transition: all 0.2s;
}

.quick-search-input:focus {
    outline: none;
    border-color: #f1c40f;
    box-shadow: 0 0 0 3px rgba(241, 196, 15, 0.15);
}

.quick-results {
    margin-top: 12px;
    background: #0d0d1a;
    border: 1px solid #2c3e50;
    border-radius: 12px;
    max-height: 320px;
    overflow-y: auto;
}

.quick-result-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
    border-bottom: 1px solid #2c3e50;
    transition: all 0.15s;
}

.quick-result-item:last-child {
    border-bottom: none;
}

.quick-result-item:hover {
    background: rgba(241, 196, 15, 0.1);
}

.quick-result-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3498db, #2980b9);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
}

.quick-result-info {
    flex: 1;
    min-width: 0;
}

.quick-result-name {
    font-size: 14px;
    font-weight: 600;
    color: white;
}

.quick-result-meta {
    font-size: 12px;
    color: #95a5a6;
}

.quick-result-action {
    font-size: 20px;
    flex-shrink: 0;
}

.quick-empty {
    padding: 20px;
    text-align: center;
    color: #95a5a6;
    font-size: 13px;
}

.badge-count {
    display: inline-block;
    padding: 2px 10px;
    background: rgba(46, 204, 113, 0.2);
    color: #2ecc71;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}

.attendance-list-section {
    margin-bottom: 24px;
}

.attendance-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 15px;
}

.attendance-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: #1a1a2e;
    border: 1px solid #2c3e50;
    border-left: 4px solid #2ecc71;
    border-radius: 12px;
    transition: all 0.2s;
}

.attendance-card:hover {
    border-color: #2ecc71;
}

.attendance-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2ecc71, #27ae60);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    flex-shrink: 0;
}

.attendance-info {
    flex: 1;
    min-width: 0;
}

.attendance-name {
    font-size: 15px;
    font-weight: 700;
    color: white;
}

.attendance-time {
    font-size: 12px;
    color: #95a5a6;
    margin-top: 2px;
}

.attendance-remove-btn {
    background: transparent;
    border: none;
    color: #e74c3c;
    font-size: 16px;
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: all 0.2s;
}

.attendance-remove-btn:hover {
    background: rgba(231, 76, 60, 0.15);
}

/* ═══════════════════════════════════════════════════════
   👁 View-Only
   ═══════════════════════════════════════════════════════ */
.view-only-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(149, 165, 166, 0.15);
    color: #95a5a6;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid rgba(149, 165, 166, 0.3);
}

.view-only-notice {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: rgba(52, 152, 219, 0.1);
    border: 1px solid rgba(52, 152, 219, 0.3);
    border-radius: 12px;
    margin-bottom: 24px;
    color: #3498db;
    font-size: 13px;
    line-height: 1.6;
}

.view-only-notice strong {
    color: #f1c40f;
}

